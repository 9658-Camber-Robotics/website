---
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="What is FRC? - Camber Robotics"
	description="Learn about FIRST Robotics Competition (FRC), the ultimate high school robotics challenge that combines STEM education with real-world engineering experience."
	image="/FRC.png"
	url="https://camberrobotics.com/what-is-frc"
>
	<section class="py-20 sm:py-28 px-4 sm:px-6 bg-white dark:bg-neutral-950">
		<div class="max-w-3xl mx-auto text-center">
			<h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-6 text-neutral-900 dark:text-white">
				What is FRC?
			</h1>
			<p class="text-base sm:text-lg md:text-xl text-neutral-600 dark:text-neutral-300 leading-relaxed">
				FIRST Robotics Competition is the ultimate high school STEM challenge, combining engineering, programming, and teamwork.
			</p>
		</div>
	</section>

	<section class="py-16 sm:py-20 px-4 sm:px-6 bg-neutral-50 dark:bg-neutral-900">
		<div class="max-w-3xl mx-auto">
			<h2 class="text-2xl sm:text-3xl font-bold text-neutral-900 dark:text-white text-center mb-8">
				The Competition
			</h2>
			<div class="text-sm sm:text-base lg:text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed space-y-6">
				<p>
					<span class="text-neutral-900 dark:text-white font-semibold">FIRST Robotics Competition (FRC)</span> is an international high school robotics competition founded by Dean Kamen in 1989. Every year, teams of high school students, along with adult mentors, have six weeks to build and program a robot that can compete in a challenging field game.
				</p>
				<p>
					The competition combines the excitement of sports with the rigors of science and technology. Teams must design, build, and program robots to compete in alliance-based matches where strategy, teamwork, and gracious professionalism are just as important as technical skills.
				</p>
			</div>
		</div>
	</section>
</Layout>
