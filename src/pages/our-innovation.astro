---
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Our Innovation - Camber Robotics"
	description="Learn about Camber Robotics' Battery Management System - a tool developed to help FRC teams track and maintain their robot batteries effectively."
	image="/team-photo.jpg"
	url="https://camberrobotics.com/our-innovation"
>
	<section class="py-20 sm:py-32 px-4 sm:px-6 bg-white min-h-[70vh] flex items-center">
		<div class="max-w-3xl mx-auto text-center">
			<h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-6 text-neutral-900">Our Innovation</h1>
			<p class="text-base sm:text-lg lg:text-xl leading-relaxed text-neutral-600 mb-6">
				Camber's lead programmer developed a <span class="font-semibold text-neutral-900">Battery Management System</span> to help FRC teams track and maintain their robot batteries effectively.
			</p>
			<p class="text-sm sm:text-base lg:text-lg leading-relaxed text-neutral-600">
				See what it's like at <a href="https://batteries.camberrobotics.com" class="font-semibold text-blue-600 hover:underline" target="_blank" rel="noopener noreferrer">batteries.camberrobotics.com</a>.
			</p>
		</div>
	</section>
</Layout>
