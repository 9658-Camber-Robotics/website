---
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Our Innovation - Camber Robotics"
	description="Camber Batteries and Camber Scouting, two web apps built by Camber Robotics to help FRC teams at competition (2024-2025)."
	image="/team-photo.jpg"
	url="https://camberrobotics.com/our-innovation"
>
	<section class="py-20 sm:py-28 px-4 sm:px-6 bg-white dark:bg-neutral-950">
		<div class="max-w-3xl mx-auto text-center">
			<h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-6 text-neutral-900 dark:text-white">Our Innovation</h1>
			<p class="text-base sm:text-lg lg:text-xl leading-relaxed text-neutral-600 dark:text-neutral-300">
				Beyond competition, our students have built their own software to make FRC competition day run smoother.
			</p>
		</div>
	</section>

	<section class="py-16 sm:py-20 px-4 sm:px-6 bg-neutral-50 dark:bg-neutral-900">
		<div class="max-w-3xl mx-auto scroll-animate space-y-10">
			<div>
				<h2 class="text-xl sm:text-2xl font-bold mb-2 text-neutral-900 dark:text-white">Camber Batteries <span class="text-neutral-500 dark:text-neutral-400 font-normal text-base">(2024&ndash;2025)</span></h2>
				<p class="text-sm sm:text-base lg:text-lg leading-relaxed text-neutral-600 dark:text-neutral-300">
					A battery management app built by Camber's lead programmer to help FRC teams track which batteries at competition needed to be charged. This project ended support in 2025.
				</p>
			</div>
			<div>
				<h2 class="text-xl sm:text-2xl font-bold mb-2 text-neutral-900 dark:text-white">Camber Scouting <span class="text-neutral-500 dark:text-neutral-400 font-normal text-base">(2024&ndash;2025)</span></h2>
				<p class="text-sm sm:text-base lg:text-lg leading-relaxed text-neutral-600 dark:text-neutral-300">
					A simplified scouting app to help teams track match data at competition. This project also ended support in 2025.
				</p>
			</div>
		</div>
	</section>
</Layout>
