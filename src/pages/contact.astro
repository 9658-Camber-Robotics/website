---
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Contact - Camber Robotics Team 9658"
	description="Get in touch with Camber Robotics. Contact our FRC Team 9658 from Keystone School in San Antonio, Texas."
	image="/team-photo.jpg"
	url="https://camberrobotics.com/contact"
>
	<section class="py-20 sm:py-32 px-4 sm:px-6 bg-white dark:bg-neutral-950 min-h-[70vh] flex items-center">
		<div class="max-w-2xl mx-auto text-center">
			<h1 class="text-3xl sm:text-4xl font-bold mb-4 text-neutral-900 dark:text-white">Get In Touch</h1>
			<p class="text-base sm:text-lg leading-relaxed text-neutral-600 dark:text-neutral-300 mb-8">
				Have questions about our team or want to get involved? We'd love to hear from you.
			</p>
			<a
				href="mailto:contact@camberrobotics.com"
				class="inline-block rounded-md bg-blue-600 text-white font-semibold px-8 py-3 hover:bg-blue-700 transition-colors mb-6"
			>
				Email contact@camberrobotics.com
			</a>
			<p class="text-neutral-500 dark:text-neutral-400">
				Interested in joining Camber Robotics? Email us &mdash; no experience required.
			</p>
		</div>
	</section>
</Layout>
