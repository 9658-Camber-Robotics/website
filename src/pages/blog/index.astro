---
import { getCollection } from "astro:content";
import camberLogo from "../../assets/camber-logo.png";
import { blogImages } from "../../data/blogImages.js";
import { sponsors } from "../../data/sponsors.js";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.sortDate.valueOf() - a.data.sortDate.valueOf(),
);
const [latest, ...rest] = posts;

function formatDate(post) {
	return (
		post.data.displayDate ??
		post.data.sortDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })
	);
}

const latestImg = latest.data.image ? blogImages[latest.data.image] : null;
---

<Layout
	title="Blog - Camber Robotics Team 9658"
	description="Updates from FRC Team 9658 Camber Robotics — competitions, outreach, and what we've been building."
	image="/team-photo.jpg"
	url="https://camberrobotics.com/blog"
>
	<section class="bg-white dark:bg-neutral-950 py-16 sm:py-20 px-4 sm:px-6">
		<div class="max-w-3xl mx-auto text-center">
			<h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 sm:mb-6 text-neutral-900 dark:text-white">
				Blog
			</h1>
			<p class="text-base sm:text-lg md:text-xl text-neutral-600 dark:text-neutral-300 leading-relaxed">
				Updates from the team — competitions, outreach, and what we've been building.
			</p>
		</div>
	</section>

	<section class="py-16 sm:py-20 px-4 sm:px-6 bg-neutral-50 dark:bg-neutral-900">
		<div class="max-w-6xl mx-auto grid lg:grid-cols-3 gap-10">
			<div class="lg:col-span-2">
				<!-- Latest Post -->
				<a
					href={`/blog/${latest.id}`}
					class="block bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 rounded-lg overflow-hidden shadow-sm hover:border-red-600 dark:hover:border-red-400 transition-colors mb-8"
				>
					{latestImg ? (
						<img src={latestImg.src} alt={latest.data.imageAlt} class="w-full h-48 sm:h-64 object-cover" />
					) : (
						<div class="h-32 sm:h-40 flex items-center justify-center bg-neutral-50 dark:bg-neutral-900">
							<img src={camberLogo.src} alt="Camber Robotics logo" class="w-14 h-14 dark:invert" />
						</div>
					)}
					<div class="p-6">
						<p class="text-red-600 dark:text-red-400 font-semibold text-xs uppercase tracking-wide mb-2">Latest Post</p>
						<p class="text-neutral-500 dark:text-neutral-400 text-sm mb-1">{formatDate(latest)}</p>
						<h2 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-white mb-2">{latest.data.title}</h2>
						<p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-300 leading-relaxed">{latest.data.excerpt}</p>
						<p class="mt-4 font-semibold text-red-600 dark:text-red-400">Read the full post &rarr;</p>
					</div>
				</a>

				<!-- Other Posts -->
				<div class="grid gap-4 sm:gap-6">
					{rest.map((post) => {
						const img = post.data.image ? blogImages[post.data.image] : null;
						return (
							<a
								href={`/blog/${post.id}`}
								class="block bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 rounded-lg overflow-hidden shadow-sm hover:border-red-600 dark:hover:border-red-400 transition-colors"
							>
								<div class="sm:flex sm:items-center">
									{img && (
										<img
											src={img.src}
											alt={post.data.imageAlt}
											class="w-full sm:w-48 h-40 sm:h-32 object-cover shrink-0"
										/>
									)}
									<div class="p-5 sm:p-6">
										<p class="text-neutral-500 dark:text-neutral-400 text-sm mb-1">{formatDate(post)}</p>
										<h2 class="text-lg sm:text-xl font-bold text-neutral-900 dark:text-white mb-1">{post.data.title}</h2>
										<p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-300 leading-relaxed">{post.data.excerpt}</p>
									</div>
								</div>
							</a>
						);
					})}
				</div>
			</div>

			<aside class="lg:sticky lg:top-24 lg:self-start">
				<div class="bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 rounded-lg p-6 text-center">
					<h2 class="font-bold text-neutral-900 dark:text-white mb-4">Our Sponsors</h2>
					<div class="grid grid-cols-3 gap-2">
						{sponsors.map((sponsor) => (
							<a
								href={sponsor.url}
								target="_blank"
								rel="noopener noreferrer"
								class="flex items-center justify-center h-12 border border-neutral-200 dark:border-neutral-700 rounded-md bg-white dark:bg-neutral-900 p-1 hover:border-red-600 dark:hover:border-red-400 transition-colors"
							>
								{sponsor.logo ? (
									sponsor.logoDark ? (
										<>
											<img src={sponsor.logo.src} alt={sponsor.name} class="max-h-8 max-w-full object-contain dark:hidden" />
											<img src={sponsor.logoDark.src} alt={sponsor.name} class="max-h-8 max-w-full object-contain hidden dark:block" />
										</>
									) : (
										<img
											src={sponsor.logo.src}
											alt={sponsor.name}
											class={`max-h-8 max-w-full object-contain ${sponsor.filterClass || ""}`}
										/>
									)
								) : (
									<span class="text-[10px] font-semibold text-neutral-700 dark:text-neutral-300 text-center leading-tight">{sponsor.name}</span>
								)}
							</a>
						))}
					</div>
					<a href="/sponsors" class="inline-block mt-4 text-sm font-semibold text-red-600 dark:text-red-400 hover:underline">
						Become a Sponsor &rarr;
					</a>
				</div>
			</aside>
		</div>
	</section>
</Layout>
