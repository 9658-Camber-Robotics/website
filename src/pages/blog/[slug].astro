---
import { getCollection, render } from "astro:content";
import PostHeader from "../../components/PostHeader.astro";
import { blogImages } from "../../data/blogImages.js";
import { sponsors } from "../../data/sponsors.js";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	const chronological = [...posts].sort((a, b) => a.data.sortDate.valueOf() - b.data.sortDate.valueOf());

	return chronological.map((post, index) => {
		const otherPosts = posts
			.filter((p) => p.id !== post.id)
			.sort((a, b) => b.data.sortDate.valueOf() - a.data.sortDate.valueOf())
			.slice(0, 6);

		return {
			params: { slug: post.id },
			props: {
				post,
				prevPost: chronological[index - 1] ?? null,
				nextPost: chronological[index + 1] ?? null,
				otherPosts,
			},
		};
	});
}

const { post, prevPost, nextPost, otherPosts } = Astro.props;
const { Content } = await render(post);

function formatDate(p) {
	return (
		p.data.displayDate ??
		p.data.sortDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })
	);
}

const dateline = formatDate(post);
const img = post.data.image ? blogImages[post.data.image] : null;
---

<Layout
	title={`${post.data.title} - Camber Robotics Blog`}
	description={post.data.excerpt}
	image="/team-photo.jpg"
	url={`https://camberrobotics.com/blog/${post.id}`}
>
	<section class="py-16 sm:py-20 px-4 sm:px-6 bg-white dark:bg-neutral-950">
		<div class="max-w-6xl mx-auto grid lg:grid-cols-3 gap-10">
			<div class="lg:col-span-2">
				<a href="/blog" class="inline-block text-sm font-semibold text-red-600 dark:text-red-400 hover:underline mb-8">
					&larr; Back to Blog
				</a>

				{img ? (
					<>
						<img src={img.src} alt={post.data.imageAlt} class="w-full h-56 sm:h-72 object-cover rounded-lg shadow-sm mb-6" />
						<p class="text-neutral-500 dark:text-neutral-400 text-sm mb-2">{dateline}</p>
						<h1 class="text-2xl sm:text-3xl font-bold text-neutral-900 dark:text-white mb-8">{post.data.title}</h1>
					</>
				) : (
					<PostHeader headline={post.data.title} dateline={dateline} />
				)}

				<div class="post-content text-sm sm:text-base text-neutral-600 dark:text-neutral-300 leading-relaxed">
					<Content />
				</div>

				<div class="grid sm:grid-cols-2 gap-4 mt-12 pt-8 border-t border-neutral-200 dark:border-neutral-700">
					{prevPost ? (
						<a
							href={`/blog/${prevPost.id}`}
							class="block bg-neutral-50 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-700 rounded-lg p-4 hover:border-red-600 dark:hover:border-red-400 transition-colors"
						>
							<p class="text-xs font-semibold text-neutral-500 dark:text-neutral-400 mb-1">&larr; Previous</p>
							<p class="text-sm font-semibold text-neutral-900 dark:text-white">{prevPost.data.title}</p>
						</a>
					) : (
						<div />
					)}
					{nextPost ? (
						<a
							href={`/blog/${nextPost.id}`}
							class="block text-right bg-neutral-50 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-700 rounded-lg p-4 hover:border-red-600 dark:hover:border-red-400 transition-colors sm:col-start-2"
						>
							<p class="text-xs font-semibold text-neutral-500 dark:text-neutral-400 mb-1">Next &rarr;</p>
							<p class="text-sm font-semibold text-neutral-900 dark:text-white">{nextPost.data.title}</p>
						</a>
					) : (
						<div />
					)}
				</div>
			</div>

			<aside class="space-y-8">
				<div class="bg-neutral-50 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-700 rounded-lg p-6">
					<h2 class="font-bold text-neutral-900 dark:text-white mb-4">More From the Blog</h2>
					<ul class="space-y-4">
						{otherPosts.map((p) => (
							<li>
								<a href={`/blog/${p.id}`} class="block group">
									<p class="text-xs text-neutral-500 dark:text-neutral-400">{formatDate(p)}</p>
									<p class="text-sm font-semibold text-neutral-900 dark:text-white group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors">
										{p.data.title}
									</p>
								</a>
							</li>
						))}
					</ul>
					<a href="/blog" class="inline-block mt-4 text-sm font-semibold text-red-600 dark:text-red-400 hover:underline">
						View all posts &rarr;
					</a>
				</div>

				<div class="bg-neutral-50 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-700 rounded-lg p-6 text-center">
					<h2 class="font-bold text-neutral-900 dark:text-white mb-4">Our Sponsors</h2>
					<div class="grid grid-cols-3 gap-2">
						{sponsors.map((sponsor) => (
							<a
								href={sponsor.url}
								target="_blank"
								rel="noopener noreferrer"
								class="flex items-center justify-center h-12 border border-neutral-200 dark:border-neutral-700 rounded-md bg-white dark:bg-neutral-800 p-1 hover:border-red-600 dark:hover:border-red-400 transition-colors"
							>
								{sponsor.logo ? (
									sponsor.logoDark ? (
										<>
											<img src={sponsor.logo.src} alt={sponsor.name} class="max-h-8 max-w-full object-contain dark:hidden" />
											<img src={sponsor.logoDark.src} alt={sponsor.name} class="max-h-8 max-w-full object-contain hidden dark:block" />
										</>
									) : (
										<img
											src={sponsor.logo.src}
											alt={sponsor.name}
											class={`max-h-8 max-w-full object-contain ${sponsor.filterClass || ""}`}
										/>
									)
								) : (
									<span class="text-[10px] font-semibold text-neutral-700 dark:text-neutral-300 text-center leading-tight">{sponsor.name}</span>
								)}
							</a>
						))}
					</div>
					<a href="/sponsors" class="inline-block mt-4 text-sm font-semibold text-red-600 dark:text-red-400 hover:underline">
						Become a Sponsor &rarr;
					</a>
				</div>
			</aside>
		</div>
	</section>
</Layout>

<style>
	.post-content :global(p) {
		margin-bottom: 1.25rem;
	}
	.post-content :global(p:last-child) {
		margin-bottom: 0;
	}
	.post-content :global(a) {
		color: var(--color-red-600);
		font-weight: 600;
		text-decoration: underline;
	}
	:global(.dark) .post-content :global(a) {
		color: var(--color-red-400);
	}
</style>
