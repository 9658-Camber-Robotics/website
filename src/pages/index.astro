---
import { Picture } from "astro:assets";
import geneHaasImg from "../assets/GeneHaasFoundation.webp";
import honeywellImg from "../assets/Honeywell.svg";
import keystoneImg from "../assets/Keystone.png";
import pineLakeVistasImg from "../assets/PineLakeVistas.png";
import teamCommunityImg from "../assets/team-community.jpg";
import teamHeroImg from "../assets/team-hero.jpg";
import teamOutreachImg from "../assets/team-outreach.jpg";
import teamStoryImg from "../assets/team-story.jpg";
import yassImg from "../assets/YASS.png";
import Layout from "../layouts/Layout.astro";

const awards = [
	{ year: "2024", title: "Highest-Placed Rookie Team", event: "FIT District San Antonio Event" },
	{ year: "2024", title: "Judges' Award", event: "FIT District San Antonio Event" },
	{ year: "2024", title: "State Championship Qualifier", event: "Texas State Championship" },
	{ year: "2025", title: "Judge's Choice Award", event: "FIT District Houston Event" },
	{ year: "2025", title: "Alliance 4 Captain", event: "FIT District Houston Event" },
	{ year: "2025", title: "Rising All-Star Award", event: "Texas State Championship" },
];

const sponsors = [
	{ name: "Gene Haas Foundation", url: "https://www.genehaasfoundation.org", logo: geneHaasImg },
	{ name: "Honeywell", url: "https://www.honeywell.com", logo: honeywellImg },
	{ name: "Pine Lake Vistas", url: "https://pinelakevistas.com", logo: pineLakeVistasImg },
	{ name: "Yet Another Software Suite", url: "https://yetanothersoftwaresuite.com", logo: yassImg },
	{ name: "Keystone School", url: "https://www.keystoneschool.org", logo: keystoneImg },
];
---

<Layout
	title="Camber Robotics - Team 9658"
	description="FRC Team 9658 from Keystone School in San Antonio, Texas. We aim to create a robotics culture that values collaboration as much as innovation."
	image="/team-photo.jpg"
	url="https://camberrobotics.com"
>
	<!-- Hero Section -->
	<section class="bg-white py-16 sm:py-20 px-4 sm:px-6">
		<div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
			<div class="text-center lg:text-left">
				<h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 sm:mb-6 text-neutral-900">
					Camber Robotics &mdash; FRC Team <span class="text-blue-600">9658</span>
				</h1>
				<p class="text-base sm:text-lg md:text-xl text-neutral-600 max-w-2xl mx-auto lg:mx-0 leading-relaxed mb-8">
					We aim to create a robotics culture that values collaboration as much as innovation.
				</p>
				<div class="flex flex-col sm:flex-row justify-center lg:justify-start gap-4">
					<a
						href="mailto:camberrobotics@gmail.com"
						class="inline-block rounded-md bg-blue-600 text-white font-semibold px-6 py-3 hover:bg-blue-700 transition-colors"
					>
						Join Us
					</a>
					<a
						href="#community"
						class="inline-block rounded-md border border-neutral-300 text-neutral-800 font-semibold px-6 py-3 hover:border-blue-600 hover:text-blue-600 transition-colors"
					>
						Meet the Team
					</a>
				</div>
			</div>
			<Picture
				src={teamHeroImg}
				alt="Camber Robotics team members at an FRC competition"
				widths={[400, 640]}
				formats={["avif", "webp", "jpeg"]}
				sizes="(max-width: 1024px) 90vw, 45vw"
				width={640}
				height={480}
				class="w-full h-64 sm:h-80 lg:h-96 object-cover rounded-lg shadow-sm"
			/>
		</div>
	</section>

	<!-- Mission Section -->
	<section class="py-16 sm:py-20 px-4 sm:px-6 bg-neutral-50">
		<div class="max-w-3xl mx-auto text-center scroll-animate">
			<h2 class="text-2xl sm:text-3xl font-bold text-neutral-900 mb-4 sm:mb-6">
				Our Mission
			</h2>
			<p class="text-sm sm:text-base lg:text-lg text-neutral-600 leading-relaxed">
				We want to unite the worlds of STEM and the humanities: technical skills can be acquired and refined over time, but soft skills like communication, collaboration, and adaptability form the foundation of innovation and teamwork.
			</p>
		</div>
	</section>

	<!-- Community Section -->
	<section id="community" class="py-16 sm:py-20 px-4 sm:px-6 bg-white">
		<div class="max-w-5xl mx-auto scroll-animate">
			<h2 class="text-2xl sm:text-3xl font-bold text-center mb-8 sm:mb-12 text-neutral-900">Our Community</h2>
			<div class="grid lg:grid-cols-2 gap-8 sm:gap-12 items-center">
				<div>
					<Picture
						src={teamCommunityImg}
						alt="Camber Robotics team banner and pride flag at the team's workspace"
						widths={[300, 480, 640]}
						formats={["avif", "webp", "jpeg"]}
						sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
						width={600}
						height={600}
						class="w-full h-48 sm:h-64 lg:h-80 object-cover rounded-lg shadow-sm mb-6"
					/>
					<p class="text-sm sm:text-base lg:text-lg text-neutral-600 leading-relaxed mb-4">
						Camber Robotics is about <span class="font-semibold text-neutral-900">30 students</span> from Keystone School in San Antonio, Texas. We strive to build an inclusive team that encourages collaboration &mdash; our members come from Hispanic, LGBTQ+, and other backgrounds underrepresented in STEM.
					</p>
				</div>
				<div>
					<p class="text-sm sm:text-base lg:text-lg text-neutral-600 leading-relaxed mb-4">
						Our team includes people with a broad range of interests representing the next generation of many fields:
					</p>
					<ul class="space-y-2 sm:space-y-3 text-sm sm:text-base lg:text-lg text-neutral-800">
						<li class="flex items-center"><span class="w-2 h-2 bg-blue-600 rounded-full mr-3"></span>Engineering</li>
						<li class="flex items-center"><span class="w-2 h-2 bg-blue-600 rounded-full mr-3"></span>Graphic design</li>
						<li class="flex items-center"><span class="w-2 h-2 bg-blue-600 rounded-full mr-3"></span>Business</li>
						<li class="flex items-center"><span class="w-2 h-2 bg-blue-600 rounded-full mr-3"></span>Computer science</li>
						<li class="flex items-center"><span class="w-2 h-2 bg-blue-600 rounded-full mr-3"></span>The humanities</li>
						<li class="flex items-center"><span class="w-2 h-2 bg-blue-600 rounded-full mr-3"></span>Political science</li>
						<li class="flex items-center"><span class="w-2 h-2 bg-blue-600 rounded-full mr-3"></span>And more!</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- Awards Section -->
	<section id="awards" class="py-16 sm:py-20 px-4 sm:px-6 bg-neutral-50">
		<div class="max-w-4xl mx-auto scroll-animate">
			<h2 class="text-2xl sm:text-3xl font-bold text-center mb-8 sm:mb-12 text-neutral-900">Our Awards</h2>
			<div class="grid sm:grid-cols-3 gap-4 sm:gap-6">
				{awards.map((award) => (
					<div class="bg-white border border-neutral-200 rounded-lg p-5 text-center shadow-sm">
						<p class="text-blue-600 font-bold text-sm mb-2">{award.year}</p>
						<p class="font-semibold text-neutral-900 mb-1">{award.title}</p>
						<p class="text-neutral-500 text-sm">{award.event}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Story Section -->
	<section class="py-16 sm:py-20 px-4 sm:px-6 bg-white">
		<div class="max-w-4xl mx-auto scroll-animate">
			<h2 class="text-2xl sm:text-3xl font-bold text-center mb-8 text-neutral-900">Our Story</h2>
			<Picture
				src={teamStoryImg}
				alt="Camber Robotics' competition robot"
				widths={[300, 480, 640]}
				formats={["avif", "webp", "jpeg"]}
				sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
				width={600}
				height={400}
				class="w-full h-48 sm:h-64 object-cover rounded-lg shadow-sm mb-6 sm:mb-8"
			/>
			<p class="text-sm sm:text-base lg:text-lg leading-relaxed text-neutral-600">
				In 2023, a group of Keystone School students decided they wanted to create an FRC team to pursue their interests in engineering. That idea has since grown into today's Camber Robotics, which now embraces skills beyond STEM. In our rookie year, we had no mentors, little knowledge of FRC, and worked out of the corner of a middle-school classroom &mdash; and we've kept growing since. During the 2024 season we raised nearly <span class="font-semibold text-neutral-900">$10,000</span> through FRC-related organizations and local businesses, matched by Keystone. Our leadership runs SA Smart, a nonprofit for water conservation, and our team includes NHS officers with <span class="font-semibold text-neutral-900">4,000+ volunteer hours</span> combined.
			</p>
		</div>
	</section>

	<!-- Outreach Section -->
	<section class="py-16 sm:py-20 px-4 sm:px-6 bg-neutral-50">
		<div class="max-w-4xl mx-auto scroll-animate">
			<h2 class="text-2xl sm:text-3xl font-bold text-neutral-900 text-center mb-8 sm:mb-12">
				Our Outreach & Service
			</h2>
			<Picture
				src={teamOutreachImg}
				alt="Camber Robotics students collaborating on their robot"
				formats={["avif", "webp", "jpeg"]}
				widths={[300, 480]}
				sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
				width={480}
				height={640}
				class="w-full h-48 sm:h-64 object-cover rounded-lg shadow-sm mb-6 sm:mb-8"
			/>
			<div class="grid md:grid-cols-2 gap-6 sm:gap-8">
				<div>
					<h3 class="text-lg sm:text-xl font-bold mb-2 sm:mb-3 text-neutral-900">Fundraising</h3>
					<p class="text-sm sm:text-base lg:text-lg leading-relaxed text-neutral-600">
						During the 2024 season, we raised nearly <span class="font-semibold text-neutral-900">$10,000</span> through connecting with FRC-related organizations and local businesses; this amount was matched by Keystone.
					</p>
				</div>
				<div>
					<h3 class="text-lg sm:text-xl font-bold mb-2 sm:mb-3 text-neutral-900">Community Impact</h3>
					<p class="text-sm sm:text-base lg:text-lg leading-relaxed text-neutral-600">
						Our leadership runs SA Smart, a nonprofit for water conservation. Our team includes NHS officers with <span class="font-semibold text-neutral-900">4,000+ volunteer hours</span> combined.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Sponsors Section -->
	<section class="py-16 sm:py-20 px-4 sm:px-6 bg-white">
		<div class="max-w-5xl mx-auto scroll-animate">
			<h2 class="text-2xl sm:text-3xl font-bold text-center mb-8 sm:mb-12 text-neutral-900">Our Sponsors</h2>
			<div class="flex justify-center items-center gap-6 sm:gap-10 flex-wrap">
				{sponsors.map((sponsor) => (
					<a
						href={sponsor.url}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center justify-center h-20 sm:h-24 w-40 sm:w-48 border border-neutral-200 rounded-lg px-4 hover:border-blue-600 transition-colors"
					>
						{sponsor.logo ? (
							<img src={sponsor.logo.src} alt={sponsor.name} class="max-h-14 sm:max-h-16 max-w-full object-contain" />
						) : (
							<span class="text-neutral-700 font-semibold text-center text-sm sm:text-base">{sponsor.name}</span>
						)}
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- Technology Partner Callout -->
	<section class="py-16 sm:py-20 px-4 sm:px-6 bg-blue-50">
		<div class="max-w-3xl mx-auto text-center scroll-animate">
			<p class="text-blue-600 font-semibold text-sm uppercase tracking-wide mb-3">Technology Partner</p>
			<a href="https://yetanothersoftwaresuite.com" target="_blank" rel="noopener noreferrer" class="inline-block mb-4">
				<img src={yassImg.src} alt="Yet Another Software Suite" class="h-12 sm:h-16 mx-auto object-contain" />
			</a>
			<h2 class="text-2xl sm:text-3xl font-bold text-neutral-900 mb-4">Yet Another Software Suite</h2>
			<p class="text-sm sm:text-base lg:text-lg text-neutral-700 leading-relaxed">
				Yet Another Software Suite supports Camber Robotics both as a financial sponsor and as a technology partner, collaborating with our team on software tooling.
			</p>
			<!-- TODO: confirm specifics of the technical collaboration with Yet Another Software Suite and refine this copy. -->
		</div>
	</section>

	<!-- Instagram Section -->
	<section class="py-16 sm:py-20 px-4 sm:px-6 bg-neutral-50">
		<div class="max-w-3xl mx-auto text-center scroll-animate">
			<h2 class="text-2xl sm:text-3xl font-bold text-neutral-900 mb-2">Follow Us</h2>
			<p class="text-neutral-600 mb-8">
				<a href="https://www.instagram.com/camber.9658/" target="_blank" rel="noopener noreferrer" class="font-semibold text-blue-600 hover:underline">@camber.9658</a>
				&mdash; see our latest photos below.
			</p>
			<!-- TODO: replace WIDGET_ID with a real SnapWidget feed ID for @camber.9658 (create one for free at snapwidget.com). LightWidget/Elfsight are drop-in swaps if preferred. -->
			<iframe
				src="https://snapwidget.com/embed/WIDGET_ID"
				class="snapwidget-widget w-full"
				style="border:none; overflow:hidden; width:100%; height:400px;"
				title="Camber Robotics Instagram feed"
			></iframe>
		</div>
	</section>

	<!-- Join CTA Section -->
	<section class="py-16 sm:py-24 px-4 sm:px-6 bg-blue-600">
		<div class="max-w-2xl mx-auto text-center scroll-animate">
			<h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">Interested in Joining Camber Robotics?</h2>
			<p class="text-blue-100 mb-8">
				We're always looking for new students to join our team &mdash; no experience required.
			</p>
			<a
				href="mailto:camberrobotics@gmail.com"
				class="inline-block rounded-md bg-white text-blue-600 font-semibold px-8 py-3 hover:bg-blue-50 transition-colors"
			>
				Email camberrobotics@gmail.com
			</a>
		</div>
	</section>
</Layout>
